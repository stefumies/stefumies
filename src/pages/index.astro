---
import { getCollection } from 'astro:content';
import BackgroundMesh from '../components/BackgroundMesh.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { postEmoji } from '../postEmoji';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
	<BackgroundMesh />
	<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<ul class="entry-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<div class="entry-content">
									<time><FormattedDate date={post.data.pubDate} /></time>
									<span class="entry-title">{post.data.title}</span>
									{post.data.description && (
										<p class="entry-desc">{post.data.description}</p>
									)}
								</div>
								<div class="entry-thumb">
									{post.data.heroImage
										? <img src={post.data.heroImage.src} alt="" />
										: <span class="entry-thumb-emoji" aria-hidden="true">{postEmoji(post.id)}</span>
									}
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.entry-list li {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	.entry-list li:last-child {
		border-bottom: none;
	}
	.entry-list li:first-child {
		border-top: 1px solid var(--border);
	}
	.entry-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		text-decoration: none;
		color: var(--text);
	}
	.entry-list a:hover .entry-title {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.entry-content {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		flex: 1;
		min-width: 0;
	}
	time {
		font-size: 0.9rem;
		color: var(--text-muted);
		white-space: nowrap;
	}
	.entry-title {
		font-weight: 600;
		font-size: 1.1rem;
	}
	.entry-desc {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	.entry-thumb {
		flex-shrink: 0;
		width: 4rem;
		height: 4rem;
		border-radius: 6px;
		overflow: hidden;
	}
	.entry-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.entry-thumb-emoji {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		font-size: 1.75rem;
		line-height: 1;
		user-select: none;
	}
	@media (max-width: 480px) {
		.entry-thumb {
			width: 3rem;
			height: 3rem;
		}
	}
</style>
