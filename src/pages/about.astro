---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About — stefumies." description="About Steve Davies, software developer." />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				Hi, I'm Steve — a software developer based in the UK. I work across the stack, with a
				background in Java, TypeScript, Python, Go, cloud infrastructure, and software architecture.
			</p>
			<p>
				This is my small corner of the internet — a personal diary where I write about things I'm
				building, learning, or just thinking about.
			</p>
			<p>
				You can reach me at <a href="mailto:stefumies@outlook.com">stefumies@outlook.com</a> or
				find me on <a href="https://www.linkedin.com/in/stevemdavies/" target="_blank" rel="noopener">LinkedIn</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
