---
const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()} Stephen Davies &mdash;
		<a href="https://www.linkedin.com/in/stevemdavies/" target="_blank" rel="noopener">LinkedIn</a>
		&middot;
		stefumies(at)gmail.com
	</p>
	<p class="footer-subline">coder • ai explorer • software curmudgeon</p>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 1rem 3rem;
		text-align: center;
	}
	footer p {
		max-width: var(--max-width);
		margin: 0 auto;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.footer-subline {
		font-family: "Silkscreen", monospace;
		font-size: 0.65rem;
		letter-spacing: 0.05em;
		margin-top: 0.5rem !important;
	}
	footer a {
		color: var(--text-muted);
	}
	footer a:hover {
		color: var(--text);
	}
</style>
