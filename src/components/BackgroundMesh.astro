---
// Decorative botanical background: hand-drawn fern frond silhouettes scattered
// along the bottom edge in delicate line-art. Pure inline SVG, fixed, ignores
// pointer events, rises and fades in on load.
---

<div class="bg-forest" aria-hidden="true">
	<div class="bg-mobile-mesh"></div>
</div>

<style>
	.bg-forest {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
	}

	.bg-mobile-mesh {
		display: block;
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 100vh;
		background:
			radial-gradient(circle at center, rgba(92, 64, 51, 0.28) 0 1px, transparent 1.5px) left bottom / 24px 24px,
			linear-gradient(to right, rgba(92, 64, 51, 0.12) 1px, transparent 1px) left bottom / 24px 100%;
		-webkit-mask-image: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.92) 0%,
			rgba(0, 0, 0, 0.92) 32%,
			rgba(0, 0, 0, 0.58) 62%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.92) 0%,
			rgba(0, 0, 0, 0.92) 32%,
			rgba(0, 0, 0, 0.58) 62%,
			transparent 100%
		);
	}

	:global(html[data-theme="dark"] .bg-mobile-mesh) {
		background:
			radial-gradient(circle at center, rgba(200, 168, 130, 0.2) 0 1px, transparent 1.5px) left bottom / 24px 24px,
			linear-gradient(to right, rgba(200, 168, 130, 0.08) 1px, transparent 1px) left bottom / 24px 100%;
	}
</style>
