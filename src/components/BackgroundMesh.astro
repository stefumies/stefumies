---
// Decorative wireframe-globe background: two partial globes fading in from
// the left and right edges. Pure inline SVG, fixed, ignores pointer events.
---

<div class="bg-mesh" aria-hidden="true">
	<svg class="globe" viewBox="-100 -100 200 200" preserveAspectRatio="xMidYMid meet">
		<g fill="none" stroke="currentColor" stroke-width="0.35" vector-effect="non-scaling-stroke">
			<circle cx="0" cy="0" r="99" />
			<ellipse cx="0" cy="0" rx="99" ry="22" />
			<ellipse cx="0" cy="0" rx="92" ry="55" />
			<ellipse cx="0" cy="0" rx="72" ry="85" />
			<ellipse cx="0" cy="0" rx="22" ry="99" />
			<ellipse cx="0" cy="0" rx="55" ry="99" />
			<ellipse cx="0" cy="0" rx="85" ry="99" />
		</g>
	</svg>
</div>

<style>
	.bg-mesh {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
		color: var(--mesh-line);
	}
	.globe {
		position: absolute;
		left: 50%;
		bottom: -68vmin;
		width: 110vmin;
		height: 110vmin;
		transform: translateX(-50%);
		opacity: 0.55;
		-webkit-mask-image: radial-gradient(circle at 50% 28%, #000 14%, transparent 62%);
		mask-image: radial-gradient(circle at 50% 28%, #000 14%, transparent 62%);
	}

	@media (max-width: 720px) {
		.globe {
			width: 180vw;
			height: 180vw;
			bottom: -115vw;
			-webkit-mask-image: radial-gradient(circle at 50% 30%, #000 14%, transparent 58%);
			mask-image: radial-gradient(circle at 50% 30%, #000 14%, transparent 58%);
		}
	}
</style>

</style>
