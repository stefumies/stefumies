---
import HeaderLink from "./HeaderLink.astro";
---

<header>
    <nav aria-label="Main navigation">
        <a href="/" class="site-logo" aria-label="stefumies home">
            <img src="/logo_pack/stefumies-logo-light.svg" alt="stefumies" class="logo-img logo-light" />
            <img src="/logo_pack/stefumies-logo-dark.svg" alt="stefumies" class="logo-img logo-dark" />
        </a>
        <div class="nav-links">
            <HeaderLink href="/">entries</HeaderLink>
            <HeaderLink href="/about">about</HeaderLink>
            <button
                id="music-toggle"
                class="is-off"
                aria-label="Toggle background music"
                aria-pressed="false">🎵</button
            >
            <button
                id="theme-toggle"
                aria-label="Toggle dark mode"
                aria-pressed="false">🌙</button
            >
        </div>
        <audio id="bg-music" src="/loop.mp3" loop preload="none"></audio>
    </nav>
</header>

<script is:inline>
    function updateIcon() {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const isDark = document.documentElement.dataset.theme === "dark";
        btn.textContent = isDark ? "☀️" : "🌙";
        btn.setAttribute("aria-pressed", String(isDark));
    }
    updateIcon();
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next =
            document.documentElement.dataset.theme === "dark"
                ? "light"
                : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        updateIcon();
    });

    (function () {
        const btn = document.getElementById("music-toggle");
        const audio = document.getElementById("bg-music");
        if (!btn || !audio) return;
        audio.volume = 0.15;
        function apply(state) {
            const on = state === "on";
            btn.classList.toggle("is-off", !on);
            btn.setAttribute("aria-pressed", String(on));
        }
        apply(localStorage.getItem("music") ?? "off");
        btn.addEventListener("click", () => {
            const next =
                (localStorage.getItem("music") ?? "off") === "on"
                    ? "off"
                    : "on";
            localStorage.setItem("music", next);
            apply(next);
            if (next === "on") {
                const p = audio.play();
                if (p && typeof p.catch === "function") p.catch(() => {});
            } else {
                audio.pause();
            }
        });
    })();
</script>

<style>
    header {
        padding: 0 1rem;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
    }
    nav {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 5rem;
    }
    .site-logo {
        display: flex;
        align-items: center;
        color: var(--text);
        text-decoration: none;
        transition: color 0.15s;
    }
    .logo-brand {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: -0.04em;
        line-height: 1;
    }
    .logo-img {
        height: 2.25rem;
        width: auto;
        display: block;
    }
    :global(html[data-theme="light"] .logo-dark),
    :global(html[data-theme="dark"] .logo-light) {
        display: none;
    }
    .site-logo:hover {
        color: var(--accent);
    }
    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    .nav-links a {
        font-size: 0.9rem;
        font-weight: 500; /* fixed — changing weight shifts layout */
        text-decoration: none;
        color: var(--text-muted);
        transition: color 0.15s;
    }
    .nav-links a:hover,
    .nav-links a.active {
        color: var(--text);
    }
    #theme-toggle,
    #music-toggle {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        color: var(--text-muted);
        padding: 0;
        line-height: 1;
        transition: color 0.15s, opacity 0.15s;
    }
    #theme-toggle:hover,
    #music-toggle:hover {
        color: var(--text);
    }
    #music-toggle.is-off {
        opacity: 0.45;
        text-decoration: line-through;
        text-decoration-thickness: 0.12em;
    }
</style>
